<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('./partials/head') %>
    <title>Add Blog</title>
</head>
<body class="bg-gray-900">
    <%- include('./partials/nav') %>
    
    <form action="/blog" method="post" enctype="multipart/form-data" class="flex flex-col gap-10 items-center justify-center  p-15">

        
            <div>
            
                <label class="block mb-2 text-2xl font-medium text-gray-900 dark:text-white " for="coverimage">Cover Image</label>
                <input name="coverImage" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-full cursor-pointer" id="coverimage" type="file">
                
                        </div>

        <div class="mt-15 w-[40vw] ">
        
        

        <label for="title" class="block mb-2   font-medium text-center text-gray-900 dark:text-white text-2xl">Title</label>
                            <input type="text" name="title" id="title" class="text-center bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" placeholder="title" required="true">
                        </div>

       
        <div class="flex flex-col gap-5 ">
            
<label for="body" class="block mb-2 text-2xl font-medium text-gray-900 dark:text-white">Body</label>
<textarea id="body" rows="4" name="body" class="block p-2.5 w-[40vw] text-md text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"  placeholder="Write your thoughts here..."></textarea>

        </div>

        <div>
            <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-full">
                Submit
              </button>
        </div>
        
    </form>
 
    
    
</body>
</html>